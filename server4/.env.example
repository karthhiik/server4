openrouter_apikey_minimax=

#======V4 Quality & Anti-Hallucination======
# Instruction decomposition: focused ~500-token prompts instead of ~3000-token monolithic (reduces hallucination)
V4_ENABLE_DECOMPOSED_PROMPTS=true
# TOON format: Token-Oriented Object Notation for LLM responses (saves 40-60% tokens)
V4_ENABLE_TOON_FORMAT=true
# Premium pre-export boardroom rehearsal judge. Default off; enabling adds one cached LLM judge call.
V4_ENABLE_BOARDROOM_JUDGE=false




